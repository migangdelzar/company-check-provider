{
  "name": "company-check-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --frozen-lockfile test/*.test.ts",
    "test:contract": "bun test --frozen-lockfile test/contract.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "bun run src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "security": "trivy fs --exit-code 1 --severity HIGH,CRITICAL .",
    "licenses": "licensee detect --config .licensee.yml"
  },
  "dependencies": {
    "@fastify/sensible": "6.0.3",
    "fastify": "5.6.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/bun": "1.2.22",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0"
  }
}
